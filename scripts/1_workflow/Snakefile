import json
from pathlib import Path

config = {
    "nailpolish": "/vast/projects/davidson_longread/cheng.o/proj/26.08.18-run-np/nailpolish_v0.2.2",
    "outdir": "results",
    "threads": 16,
    "minimap_threads": 16
}

DATA_DIR = "/vast/projects/davidson_longread/cheng.o/proj/25.06.17-np-benchmark/datasets/"

with open("samples.json") as _f:
    SAMPLES = json.load(_f)

for entry in SAMPLES.values():
    for field in ("path", "transcriptome", "genome", "gtf"):
        if field in entry and isinstance(entry[field], str):
            entry[field] = str(Path(entry[field]).resolve())

OUTDIR         = config["outdir"]
NP_DIR         = OUTDIR + "/nailpolish"
ALIGN_DIR      = OUTDIR + "/alignment"
PROCESSING_DIR = OUTDIR + "/_processing"
RESULTS_DIR    = OUTDIR + "/_results"
